// ============================================================================
// PRISMA SCHEMA
// ============================================================================
// This file is the single source of truth for your database structure.
// Prisma reads this file and generates:
//   1. A TypeScript client (`@prisma/client`) with fully-typed query methods
//      like `prisma.photo.findMany()` — no hand-written SQL, no `any` types.
//   2. SQL migration files (via `npx prisma migrate dev`) that create/alter
//      the actual tables in your PostgreSQL database to match this file.
//
// LEARNING NOTE: think of this file as a blueprint. You edit the blueprint,
// then run a migration command, and Prisma changes the real database to
// match. You (almost) never hand-write SQL for schema changes.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // `env("DATABASE_URL")` means: read the connection string from an
  // environment variable instead of hard-coding it here. Never commit real
  // credentials — see `.env.example` for the format.
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// USER — the site admin. This is a small portfolio site with ONE admin
// (you), not a multi-user platform, so this model is intentionally simple.
// ----------------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  // `cuid()` generates a collision-resistant unique ID, e.g. "clh3x9f8a0000...".
  // Alternative you'll see in other projects: `@default(uuid())`.
  email         String   @unique
  // `@unique` adds a database-level constraint: two rows can never share
  // an email. Prisma throws a typed error if you try.
  passwordHash  String
  // We NEVER store plaintext passwords. `passwordHash` holds the output of
  // bcrypt hashing (see src/lib/auth.ts). Even if the database leaks, raw
  // passwords are not recoverable from a bcrypt hash.
  name          String?
  // The `?` makes a field optional (nullable in SQL). Compare to `email`
  // above, which is required.
  createdAt     DateTime @default(now())

  @@map("users")
  // `@@map` renames the underlying SQL table to "users" (snake_case is the
  // SQL convention) while keeping the Prisma model name "User" (PascalCase,
  // the TypeScript/JS convention). Purely cosmetic, but good practice.
}

// ----------------------------------------------------------------------------
// ALBUM — a named collection of photos, e.g. "Iceland 2025" or "Portraits".
// ----------------------------------------------------------------------------
model Album {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  // The slug is the URL-friendly version of the title, e.g. "iceland-2025".
  // We generate it from the title when an album is created (see
  // src/lib/slug.ts) and use it in routes like /albums/iceland-2025 instead
  // of exposing the raw database ID in the URL.
  description String?
  coverPhotoId String? @unique
  // Optional pointer to one Photo to use as the album's thumbnail. It's a
  // separate relation (defined below) rather than "just use the first
  // photo" so you can deliberately pick the best cover image.
  coverPhoto  Photo?   @relation("AlbumCover", fields: [coverPhotoId], references: [id])
  photos      Photo[]  @relation("AlbumPhotos")
  // This is the "many" side of a one-to-many relationship: one Album has
  // many Photos. Prisma infers the relationship from the matching
  // `@relation` on the Photo model below.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // `@updatedAt` auto-sets this field to the current time every time the
  // row is updated — Prisma manages it, you never set it manually.

  @@map("albums")
}

// ----------------------------------------------------------------------------
// PHOTO — a single uploaded image and its metadata.
// ----------------------------------------------------------------------------
model Photo {
  id          String   @id @default(cuid())
  title       String?
  description String?
  storageKey  String   @unique
  // The object's key (path) inside the S3 bucket, e.g.
  // "photos/2026/09/clh3x9f8a0000-sunset.jpg". We store the KEY, not a full
  // URL, because:
  //   1. If you ever move buckets/CDNs, you only change one config value,
  //      not every row in the database.
  //   2. The public URL can be derived: `${CDN_BASE_URL}/${storageKey}`.
  width       Int
  height      Int
  // Storing the original image dimensions lets the frontend reserve the
  // correct aspect-ratio box BEFORE the image loads, preventing layout
  // shift (this is exactly what next/image's `width`/`height` props need).
  blurDataUrl String?  @db.Text
  // A tiny base64-encoded placeholder image (a few hundred bytes) shown
  // while the full photo loads — the "blur-up" effect. `@db.Text` tells
  // Postgres to use an unbounded TEXT column instead of the default
  // VARCHAR(191), since base64 blur data can be longer than that.
  featured    Boolean  @default(false)
  // Lets the admin pin certain photos to the homepage hero section.

  albumId     String?
  album       Album?   @relation("AlbumPhotos", fields: [albumId], references: [id], onDelete: SetNull)
  // `onDelete: SetNull` — if an Album is deleted, its photos are NOT
  // deleted with it; their `albumId` is just set back to null. This is a
  // deliberate safety choice (compare to `onDelete: Cascade`, which WOULD
  // delete the photos too). Getting this decision right for every relation
  // is a classic backend/data-modeling interview topic.
  coverOfAlbum Album?  @relation("AlbumCover")
  // The inverse side of Album.coverPhoto above — lets Prisma know a Photo
  // can be referenced as one Album's cover.

  tags        PhotoTag[]
  // Many-to-many relationships in Prisma need an explicit "join model" when
  // you want extra fields on the relationship itself (here we don't need
  // any extra fields, but an explicit join model is still shown so you can
  // see how it works — see PhotoTag below). The simpler alternative for a
  // plain many-to-many is `tags Tag[]` with no join model at all.

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([albumId])
  // An index speeds up queries that filter by this column, e.g.
  // `prisma.photo.findMany({ where: { albumId } })` — very common when
  // rendering an album page. Without an index, Postgres would scan every
  // row in the table to find matches.
  @@index([createdAt])
  // Speeds up the default "newest first" gallery sort.
  @@map("photos")
}

// ----------------------------------------------------------------------------
// TAG — a label like "landscape", "b&w", "film". Many photos can share a
// tag, and one photo can have many tags — a classic many-to-many.
// ----------------------------------------------------------------------------
model Tag {
  id     String     @id @default(cuid())
  name   String     @unique
  slug   String     @unique
  photos PhotoTag[]

  @@map("tags")
}

// ----------------------------------------------------------------------------
// PHOTOTAG — the explicit join table connecting Photo <-> Tag.
// ----------------------------------------------------------------------------
// LEARNING NOTE: a many-to-many relationship (many photos <-> many tags)
// can't be represented with a single foreign key like a one-to-many can.
// Relationally, it needs its own table with two foreign keys — one to each
// side. This IS that table. In raw SQL you'd write this by hand; Prisma
// just makes it a normal-looking model.
// ----------------------------------------------------------------------------
model PhotoTag {
  photoId String
  tagId   String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  // `onDelete: Cascade` here (unlike Photo.album above) — if a Photo is
  // deleted, its join-table rows should just disappear; there's nothing
  // meaningful about a "tag assignment" once the photo it tags is gone.
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  // A composite primary key made of BOTH foreign keys. This guarantees the
  // same photo can't be tagged with the same tag twice, and is the
  // standard pattern for a join table with no extra columns of its own.
  @@map("photo_tags")
}
